{
  "name": "asrin-koleksiyon-github-pages",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "ASRIN Koleksiyon & Antika — GitHub Pages için statik önizleme sürümü (demo envanter)",
  "engines": {
    "node": ">=22.23.4"
  },
  "scripts": {
    "dev": "astro dev --port 5501",
    "build": "node scripts/check-env.mjs && astro build",
    "preview": "astro preview --port 5501",
    "test": "node --import tsx --test tests/unit.test.ts",
    "check:env": "node scripts/check-env.mjs",
    "check:static": "node scripts/check-static.mjs",
    "check:types": "astro check",
    "check:catalog": "node scripts/audit-catalog.mjs"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource/cormorant-garamond": "^5.3.0",
    "astro": "^7.4.4"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@types/node": "^24.19.2",
    "sharp": "^0.35.5",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3"
  }
}
